{
  "name": "luminais-web",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build",
    "icons": "node tools/generate-icons.mjs",
    "portfolio": "cd portfolio && latexmk portfolio.tex && rm -f images/*.png && pdftoppm -r 200 -png portfolio.pdf images/portfolio"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geologica": "^5.3.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "description": "Personal site of Mikhail Trifonov (Luminais): Astro, three.js, GSAP."
}
