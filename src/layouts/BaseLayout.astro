---
import '@fontsource-variable/geologica/full.css';
import '@/styles/global.css';
import latinFont from '@fontsource-variable/geologica/files/geologica-latin-full-normal.woff2?url';
import cyrillicFont from '@fontsource-variable/geologica/files/geologica-cyrillic-full-normal.woff2?url';
import Seo from '@/components/layout/Seo.astro';
import Backdrop from '@/components/layout/Backdrop.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
}

const { locale, ...seo } = Astro.props;
const preloadFonts = locale === 'ru' ? [cyrillicFont, latinFont] : [latinFont];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <Seo locale={locale} {...seo} />
  </head>
  <body>
    <Backdrop />
    <slot />
    <script>
      import { initSmoothScroll } from '@/scripts/smooth-scroll';
      initSmoothScroll();
    </script>
  </body>
</html>
