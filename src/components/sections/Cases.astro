---
import ArchitectureDiagram from '@/components/ui/ArchitectureDiagram.astro';
import Section from '@/components/ui/Section.astro';
import { cases } from '@/content/cases';
import { formatPeriod, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useTranslations(locale);
const t = ui.cases;

const period = (start: string, end?: string) => {
  if (!end) return `${formatPeriod(start, locale)} / ${ui.experience.present}`;
  return start === end ? formatPeriod(start, locale) : `${formatPeriod(start, locale)} / ${formatPeriod(end, locale)}`;
};
---

<Section id="cases" title={t.title}>
  <div class="cases" data-tabs>
    <div class="tablist" role="tablist" aria-label={t.tabs}>
      {cases.map(({ id, l10n }, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${id}`}
          class="tab glass"
          aria-controls={`panel-${id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-goal="case_tab"
          data-goal-label={id}
        >
          <span class="tab-title">{l10n[locale].title}</span>
          <span class="tab-role">{l10n[locale].role}</span>
        </button>
      ))}
    </div>

    {cases.map(({ id, start, end, stack, diagram, l10n }, i) => {
      const c = l10n[locale];
      return (
        <article class="panel glass" role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} hidden={i !== 0}>
          <header class="head">
            <div>
              <p class="tagline">{c.tagline}</p>
              <dl class="meta">
                <div>
                  <dt>{t.role}</dt>
                  <dd>{c.role}</dd>
                </div>
                <div>
                  <dt>{t.team}</dt>
                  <dd>{c.team}</dd>
                </div>
                <div>
                  <dt>{t.period}</dt>
                  <dd>{period(start, end)}</dd>
                </div>
              </dl>
            </div>
            <div>
              <h3 class="sub">{t.outcome}</h3>
              <ul class="outcomes">
                {c.outcomes.map((o) => (
                  <li>
                    <strong>{o.value}</strong>
                    <span>{o.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </header>

          <section class="arch" aria-label={t.architecture}>
            <h3 class="sub">{t.architecture}</h3>
            <ArchitectureDiagram id={id} diagram={diagram} label={`${c.title}, ${t.architecture}`} />
            <p class="scroll-hint">{t.scroll}</p>
          </section>

          <div class="body">
            <div>
              <h3 class="sub">{t.problem}</h3>
              <p>{c.problem}</p>
              <h3 class="sub">{t.practice}</h3>
              <p>{c.practice}</p>
            </div>
            <div>
              <h3 class="sub">{t.decisions}</h3>
              <ul class="decisions">
                {c.decisions.map((d) => (
                  <li>
                    <h4>{d.title}</h4>
                    <p>{d.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <p class="stack">{stack.join(', ')}</p>
        </article>
      );
    })}
  </div>
</Section>

<script>
  import { initTabs } from '@/scripts/tabs';
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>

<style>
  .tablist {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px;
  }

  .tab {
    display: grid;
    gap: 2px;
    flex: 1 1 0;
    min-width: 200px;
    padding: 14px 20px;
    border-radius: var(--radius-m);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-fast),
      border-color var(--duration-fast),
      box-shadow var(--duration-fast);
  }

  .tab:hover {
    background: var(--surface-glass-strong);
  }

  .tab[aria-selected='true'] {
    background: var(--surface-raised);
    border-color: var(--color-accent);
    box-shadow:
      inset 0 0 0 1px var(--color-accent),
      var(--shadow-glass);
  }

  .tab-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .tab-role {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .panel {
    display: grid;
    /* minmax(0, …) lets the wide diagram scroll instead of stretching the panel */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding: var(--space-panel);
    border-radius: var(--radius-l);
  }

  /* author display beats the UA rule for [hidden], so restate it */
  .panel[hidden] {
    display: none;
  }

  .panel:not([hidden]) {
    animation: panel-in var(--duration-base) var(--ease-out);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  .head,
  .body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7);
  }

  .body {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .tagline {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    font-variation-settings: var(--font-sharp-on);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-5) 0 0;
  }

  .meta dt,
  .sub {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-strong);
  }

  .meta dd {
    margin: 2px 0 0;
  }

  .sub {
    margin-bottom: var(--space-3);
  }

  .body p + .sub {
    margin-top: var(--space-5);
  }

  .body p {
    text-wrap: pretty;
  }

  /* one grid for all rows, so labels line up whatever the value width */
  .outcomes {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
    align-items: baseline;
  }

  .outcomes li {
    display: contents;
  }

  .outcomes strong {
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    font-variation-settings: var(--font-sharp-on);
    letter-spacing: -0.02em;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .outcomes span {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .arch {
    padding: var(--space-5);
    border-radius: var(--radius-m);
    background: var(--surface-glass-strong);
    border: 1px solid var(--color-line);
  }

  .scroll-hint {
    display: none;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .decisions {
    display: grid;
    gap: var(--space-4);
  }

  .decisions h4 {
    margin: 0 0 2px;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .decisions p {
    color: var(--color-ink-muted);
  }

  .stack {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .head,
    .body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .tab {
      min-width: 168px;
      padding: 12px 16px;
    }

    .panel {
      gap: var(--space-6);
      padding: 22px;
    }

    .arch {
      padding: var(--space-3);
    }

    .scroll-hint {
      display: block;
    }
  }
</style>
