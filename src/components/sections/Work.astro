---
import ExternalIcon from '@/components/ui/ExternalIcon.astro';
import Section from '@/components/ui/Section.astro';
import { contacts } from '@/config/site';
import { projects } from '@/content/projects';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).work;

// Regular tiles sit three to a row; an unfinished last row stretches to fill the width.
const regular = projects.filter((p) => !p.featured).map((p) => p.id);
const leftover = regular.length % 3;
const stretched = new Map(regular.slice(regular.length - leftover).map((id) => [id, leftover === 1 ? 'full' : 'half']));
---

<Section id="work" title={t.title}>
  <ul class="grid">
    {projects.map(({ id, featured, href, stack, l10n }) => {
      const p = l10n[locale];
      return (
        <li class:list={['tile glass', { featured }, stretched.get(id)]}>
          <p class="context">{p.context}</p>
          <h3>
            {href ? (
              <a
                class="tile-link"
                href={href}
                target="_blank"
                rel="noopener"
                data-goal="project_open"
                data-goal-label={id}
              >
                {p.title}
                <ExternalIcon />
              </a>
            ) : (
              p.title
            )}
          </h3>
          {p.award && <p class="award">{p.award}</p>}
          <p class="text">{p.text}</p>
          <p class="stack">{stack.join(', ')}</p>
        </li>
      );
    })}
  </ul>
  <p class="more">
    <a class="link" href={contacts.github} target="_blank" rel="noopener" data-goal="social" data-goal-label="GitHub">
      {t.more}
    </a>
  </p>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .tile {
    position: relative;
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    border-radius: var(--radius-m);
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base);
  }

  .featured,
  .half {
    grid-column: span 3;
  }

  .full {
    grid-column: 1 / -1;
  }

  .featured {
    padding: var(--space-6);
  }

  .tile:has(.tile-link):hover {
    translate: 0 -3px;
    box-shadow: var(--shadow-lift);
  }

  .tile:hover :global(.ext) {
    translate: 2px -2px;
  }

  .context,
  .stack {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  .featured h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    font-variation-settings: var(--font-sharp-on);
    letter-spacing: -0.03em;
  }

  .tile-link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
  }

  /* the whole tile is clickable, the link stays the accessible name */
  .tile-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .award {
    align-self: flex-start;
    padding: 3px var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
  }

  .text {
    text-wrap: pretty;
  }

  .stack {
    margin-top: auto;
    padding-top: 10px;
  }

  .more {
    margin-top: 28px;
  }

  @media (max-width: 960px) {
    .tile,
    .featured,
    .half {
      grid-column: span 3;
    }

    .full {
      grid-column: 1 / -1;
    }

    .featured {
      grid-column: span 3;
    }
  }

  @media (max-width: 720px) {
    .tile,
    .featured,
    .half {
      grid-column: span 3;
    }

    .full {
      grid-column: 1 / -1;
    }

    .featured {
      grid-column: 1 / -1;
      padding: 22px;
    }
  }
</style>
