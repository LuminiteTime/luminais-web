---
import '@fontsource-variable/geologica/full.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import me from '../assets/me.png';
import { content, links, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const site = 'https://luminais.tech';
const canonical = new URL(lang === 'en' ? '/' : '/ru/', site).href;
const sections = ['now', 'experience', 'work', 'stack', 'contact'] as const;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f7f8fc" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="ru" href={`${site}/ru/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>
    <div class="veil" aria-hidden="true"></div>

    <header class="nav glass">
      <a class="brand" href="#top" aria-label="Luminais">Luminais</a>
      <nav aria-label={lang === 'en' ? 'Sections' : 'Разделы'}>
        <ul>
          {sections.map((id) => (
            <li>
              <a href={`#${id}`} data-nav={id}>
                {t.nav[id]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="lang" href={t.switchTo.href} hreflang={lang === 'en' ? 'ru' : 'en'} aria-label={t.switchTo.name}>
        {t.switchTo.label}
      </a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-name">
        <div class="hero-copy">
          <p class="who">
            <Image src={me} alt="" width={112} height={112} class="avatar" loading="eager" />
            <span>
              <span class="role">{t.hero.role}</span>
              <span class="alias">{t.hero.alias}</span>
            </span>
          </p>
          <h1 id="hero-name" class="name" data-name>
            <span class="line">{t.hero.first}</span>
            <span class="line">{t.hero.last}</span>
          </h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="hero-foot">
            <div class="actions">
              <a class="btn btn-primary" href="#contact">{t.hero.primary}</a>
              <a class="btn btn-ghost glass" href="#work">{t.hero.secondary}</a>
            </div>
            <ul class="facts">
              <li class="status"><span class="dot" aria-hidden="true"></span>{t.hero.status}</li>
              {t.hero.facts.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="now" class="block">
        <div class="now glass">
          <div class="now-head">
            <h2>{t.now.title}</h2>
            <p class="now-role">{t.now.role}</p>
            <p class="muted">{t.now.since}</p>
            <p class="now-text">{t.now.text}</p>
          </div>
          <ul class="impact">
            {
              t.now.items.map((it) => (
                <li>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="experience" class="block">
        <h2 class="section-title">{t.experience.title}</h2>
        <ol class="timeline">
          {
            t.experience.entries.map((e, i) => (
              <li class:list={['entry', { current: i === 0 }]}>
                <p class="when">
                  <time>{e.from}</time>
                  <time>{e.to}</time>
                </p>
                <div class="entry-body glass">
                  <h3>
                    {e.org}
                    <span class="entry-role">{e.role}</span>
                  </h3>
                  <p class="entry-summary">{e.summary}</p>
                  {e.points.length > 0 && (
                    <details open={i === 0}>
                      <summary>{t.experience.more}</summary>
                      <ul>
                        {e.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="work" class="block">
        <h2 class="section-title">{t.work.title}</h2>
        <ul class="work">
          {
            t.work.items.map((w) => (
              <li class:list={['tile glass', { featured: w.featured }]}>
                <p class="tile-context">{w.context}</p>
                <h3>
                  {w.href ? (
                    <a href={w.href} target="_blank" rel="noopener" class="tile-link">
                      {w.title}
                      <svg viewBox="0 0 16 16" aria-hidden="true" class="ext">
                        <path d="M5 11 11 5M6 5h5v5" />
                      </svg>
                    </a>
                  ) : (
                    w.title
                  )}
                </h3>
                {w.award && <p class="award">{w.award}</p>}
                <p class="tile-text">{w.text}</p>
                <p class="tile-stack">{w.stack.join(', ')}</p>
              </li>
            ))
          }
        </ul>
        <p class="more">
          <a href={links.github} target="_blank" rel="noopener" class="underline">{t.work.more}</a>
        </p>
      </section>

      <section id="stack" class="block">
        <h2 class="section-title">{t.stack.title}</h2>
        <div class="stack">
          {
            Object.entries(t.stack.groups).map(([group, items]) => (
              <div class="stack-col">
                <h3>{group}</h3>
                <ul>
                  {items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="muted langs">{t.stack.langs}</p>
      </section>

      <section id="contact" class="block">
        <div class="contact glass">
          <h2>{t.contact.title}</h2>
          <p class="contact-text">{t.contact.text}</p>
          <div class="mail-row">
            <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
            <button class="btn btn-ghost glass" type="button" data-copy={links.email} data-done={t.contact.copied}>
              {t.contact.copy}
            </button>
          </div>
          <ul class="socials">
            <li><a href={links.telegram} target="_blank" rel="noopener">Telegram</a></li>
            <li><a href={links.github} target="_blank" rel="noopener">GitHub</a></li>
            <li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><button type="button" popovertarget="wechat">WeChat</button></li>
          </ul>
          <div id="wechat" popover class="wechat glass">
            <img src="/images/wechat.jpg" alt="WeChat QR code" width="220" height="220" loading="lazy" />
            <p>{t.contact.wechatHint}</p>
            <p class="muted small">{links.wechat}</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>© {year} {t.hero.first} {t.hero.last}</p>
      <p>
        {t.footer.built}. <a href={links.source} target="_blank" rel="noopener" class="underline">{t.footer.source}</a>
      </p>
    </footer>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
