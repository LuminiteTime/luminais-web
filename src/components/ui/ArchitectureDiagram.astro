---
import type { Diagram } from '@/content/cases';

/**
 * Boxes-and-arrows diagram rendered to inline SVG from data. Nodes sit on a grid,
 * edges are straight lines clipped to the box borders, and a dashed overlay shows data flow.
 */
interface Props {
  id: string;
  diagram: Diagram;
  label: string;
}

const { id, diagram, label } = Astro.props;

const BOX = { w: 168, h: 62 };
const GAP = { x: 46, y: 46 };
const PAD = 10;
const ARROW_GAP = 7;

const cols = Math.max(...diagram.nodes.map((n) => n.col)) + 1;
const rows = Math.max(...diagram.nodes.map((n) => n.row)) + 1;
const width = cols * BOX.w + (cols - 1) * GAP.x + PAD * 2;
const height = rows * BOX.h + (rows - 1) * GAP.y + PAD * 2;

const nodes = new Map(
  diagram.nodes.map((n) => [n.id, { ...n, x: PAD + n.col * (BOX.w + GAP.x), y: PAD + n.row * (BOX.h + GAP.y) }]),
);

/** Distance from a box centre to its border along direction (dx, dy). */
const toBorder = (dx: number, dy: number) =>
  Math.min(dx ? BOX.w / 2 / Math.abs(dx) : Infinity, dy ? BOX.h / 2 / Math.abs(dy) : Infinity);

const edges = diagram.edges.flatMap((edge) => {
  const a = nodes.get(edge.from);
  const b = nodes.get(edge.to);
  if (!a || !b) return [];
  const ax = a.x + BOX.w / 2;
  const ay = a.y + BOX.h / 2;
  const length = Math.hypot(b.x - a.x, b.y - a.y);
  const dx = (b.x - a.x) / length;
  const dy = (b.y - a.y) / length;
  const start = toBorder(dx, dy) + 2;
  const end = length - toBorder(dx, dy) - ARROW_GAP;
  const [x1, y1, x2, y2] = [ax + dx * start, ay + dy * start, ax + dx * end, ay + dy * end];
  return [
    {
      ...edge,
      d: `M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`,
      mx: (x1 + x2) / 2,
      my: (y1 + y2) / 2,
    },
  ];
});

const description = diagram.edges.map((e) => `${nodes.get(e.from)?.label} to ${nodes.get(e.to)?.label}`).join(', ');
const markerId = `arrow-${id}`;
---

<figure class="diagram">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${label}: ${description}`} style={`--min:${width}px`}>
    <defs>
      <marker id={markerId} viewBox="0 0 8 8" refX="1" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L8 4L0 8z" class="arrowhead"></path>
      </marker>
    </defs>
    {edges.map((e) => (
      <g class="edge">
        <path d={e.d} class="line" marker-end={`url(#${markerId})`} />
        <path d={e.d} class="flow" />
        {e.label && (
          <text x={e.mx} y={e.my - 7} class="edge-label">
            {e.label}
          </text>
        )}
      </g>
    ))}
    {[...nodes.values()].map((n) => (
      <g class:list={['node', { accent: n.accent }]}>
        <rect x={n.x} y={n.y} width={BOX.w} height={BOX.h} rx="12" />
        <text x={n.x + BOX.w / 2} y={n.y + (n.note ? 27 : 36)} class="label">
          {n.label}
        </text>
        {n.note && (
          <text x={n.x + BOX.w / 2} y={n.y + 46} class="note">
            {n.note}
          </text>
        )}
      </g>
    ))}
  </svg>
</figure>

<style>
  .diagram {
    margin: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  svg {
    display: block;
    /* never upscale: every diagram keeps the same box and text size */
    width: min(100%, var(--min));
    min-width: min(var(--min), 640px);
    height: auto;
    font-family: var(--font-sans);
  }

  .line {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-opacity: 0.45;
    stroke-width: 1.4;
  }

  .arrowhead {
    fill: var(--color-ink-muted);
    fill-opacity: 0.6;
  }

  /* dashes travelling along each edge show the direction of data */
  .flow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 14;
    animation: flow 1.6s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -34;
    }
  }

  .edge-label {
    font-size: 11px;
    text-anchor: middle;
    fill: var(--color-ink-muted);
    paint-order: stroke;
    stroke: var(--color-bg);
    stroke-width: 4px;
  }

  .node rect {
    fill: var(--surface-raised);
    stroke: var(--color-line-strong);
  }

  .node.accent rect {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
  }

  .label {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    text-anchor: middle;
    fill: var(--color-ink);
  }

  .note {
    font-size: 11.5px;
    text-anchor: middle;
    fill: var(--color-ink-muted);
  }
</style>
