---
import { getImage } from 'astro:assets';
import portrait from '@/assets/me.png';
import { services, site } from '@/config/site';
import { localePath, locales, ogLocales, otherLocales, useTranslations, type Locale } from '@/i18n';
import { profileGraph } from '@/lib/structured-data';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Canonical path. Pages without one (404) are marked noindex. */
  path?: string;
}

const { locale, title, description, path } = Astro.props;
const { meta } = useTranslations(locale);
const absolute = (href: string) => new URL(href, site.url).href;

const canonical = path ? absolute(path) : undefined;
const ogImage = absolute(meta.ogImage);
const photo = await getImage({ src: portrait, width: 400, height: 400, format: 'jpeg' });
const graph = canonical ? profileGraph(locale, absolute(photo.src)) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<meta
  name="robots"
  content={canonical ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, follow'}
/>
{services.verification.yandex && <meta name="yandex-verification" content={services.verification.yandex} />}
{services.verification.google && <meta name="google-site-verification" content={services.verification.google} />}

{canonical && (
  <>
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={absolute(localePath(l))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(localePath('en'))} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
  </>
)}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.handle} />
<meta property="og:locale" content={ogLocales[locale]} />
{otherLocales(locale).map((l) => (
  <meta property="og:locale:alternate" content={ogLocales[l]} />
))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={meta.ogImageAlt} />
<meta property="profile:first_name" content={site.givenName} />
<meta property="profile:last_name" content={site.familyName} />
<meta property="profile:username" content={site.handle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={meta.ogImageAlt} />

{graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
