---
import { contacts, site } from '@/config/site';
import { localePath, locales, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Omit for pages that should not be indexed under a canonical URL. */
  path?: string;
}

const { locale, title, description, path } = Astro.props;
const t = useTranslations(locale);
const canonical = path ? new URL(path, site.url).href : undefined;
const ogImage = new URL(site.ogImage, site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  alternateName: site.handle,
  url: site.url,
  image: ogImage,
  jobTitle: t.meta.jobTitle,
  worksFor: { '@type': 'Organization', name: site.employer },
  email: `mailto:${contacts.email}`,
  sameAs: [contacts.github, contacts.linkedin, contacts.telegram],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{canonical && <link rel="canonical" href={canonical} />}
{canonical && locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l), site.url).href} />)}
{canonical && <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), site.url).href} />}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.handle} />
<meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

{canonical && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
