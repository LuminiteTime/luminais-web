---
/** Fixed WebGL scene behind the page plus a veil that softens it below the hero. */
---

<canvas class="scene" data-backdrop aria-hidden="true"></canvas>
<div class="veil" aria-hidden="true"></div>

<script>
  import { initBackdrop } from '@/scripts/backdrop';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-backdrop]');
  if (canvas) void initBackdrop(canvas);
</script>

<style>
  .scene,
  .veil {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene {
    display: block;
    z-index: var(--z-scene);
  }

  :global([data-scene='off']) .scene {
    display: none;
  }

  .veil {
    z-index: var(--z-veil);
    pointer-events: none;
    background: var(--color-bg);
    opacity: calc(var(--veil, 0) * 0.18);
  }
</style>
